<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    ============================================================
      MyBatis 映射文件 —— 真正的 SQL 住在这里
    ============================================================

    【namespace 是全文最重要的属性】
      它必须精确等于 Mapper 接口的"全限定名"（包名.接口名）。
      MyBatis 靠它把"接口"和"这个 XML"绑定在一起。
      写错了就会报 Invalid bound statement (not found)。

    【resultType 为什么可以简写为 Account？】
      因为 application.yml 里配了：
          type-aliases-package: com.wuweiqiu.moneylog.entity
      MyBatis 会为这个包下的类注册"别名"，别名默认就是类名（首字母不区分大小写）。
      所以这里写 "Account" 就等于写 "com.wuweiqiu.moneylog.entity.Account"。
      好处：包名改了，不用改 XML 里的每一处。
-->
<mapper namespace="com.wuweiqiu.moneylog.mapper.AccountMapper">

    <!--
        id="findAll" —— 必须和 AccountMapper 接口里的方法名完全一致！这是唯一的"接头暗号"。
        resultType   —— 告诉 MyBatis：每一行数据要封装成 Account 对象
    -->
    <select id="findAll" resultType="Account">
        <!--
            这里故意把字段一个个写出来，而不是偷懒写 SELECT *。
            理由（这是好习惯，不是啰嗦）：
              1) 明确：一眼就看清这个接口返回哪些列，不用去翻表结构
              2) 安全：表以后加了一堆大字段（比如备注、图片路径），也不会被无脑查出来
              3) 稳定：万一有人调整了表的列顺序，显式写法的结果不会错位
        -->
        SELECT id, name, balance, created_at
        FROM account
        <!--
            ============================================================
              【Day11 加的这一行 —— 今天最值钱的一行】
            ============================================================
            它把"查所有账户"变成了"查我的账户"。

            【为什么不是靠拦截器来做隔离？】
              拦截器只证明"你是合法用户"，它不知道"第 8 号账户是不是你的" ——
              因为它不认识业务。
              **隔离必须落到 SQL 这一层。**

            【少了这一行会怎样？】
              张三登录后照样能看到李四的账户 —— 这就是"水平越权"。
              它**不会报任何错**，静默地泄露数据，是最危险的一类 bug。
              （对比一下：少了 WHERE 会导致"SQL 报错"或"数据全被改"，
                至少你还看得见；而这个是完全无声的。）
            ============================================================
        -->
        WHERE user_id = #{userId}
        ORDER BY id
    </select>

    <!--
        ============================================================
          新增账户 —— 今天的第一个"写操作"
        ============================================================

        id="insert"            必须和 AccountMapper 接口的方法名一致（还是那个"接头暗号"）
        parameterType          可以省略，MyBatis 能从接口方法签名自己推断出来
    -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        <!--
            先看这条 SQL 本身，注意三个细节：

            1) 只写了 name 和 balance 两列，没写 id 和 created_at
               → id 是 AUTO_INCREMENT（自增），数据库自己发号，我们不能插手
               → created_at 有 DEFAULT CURRENT_TIMESTAMP，数据库自己盖时间戳
               这就是 Day1 建表时那两行 DEFAULT 的作用，今天兑现了。

            2) #{name} 和 #{balance} 是 MyBatis 的"占位符"
               → 它会自动从传入的 Account 对象里取同名属性的值
               → 底层用的是 JDBC 的 PreparedStatement（预编译），
                 所以不怕 SQL 注入（用户输入的是"值"，不会被当成"SQL 语句"执行）
               注意：#{} 是占位符；${} 是直接拼接字符串，**不安全，不要用它**。

            3) 结尾没有分号
               这是 MyBatis 的书写习惯，多写一般也不报错，但统一不加更规范。
        -->
        <!--
            【Day11 改动】多插了一列 user_id。
              它的值来自 #{userId} —— 也就是传进来的 Account 对象里的 userId 属性。
              那个值是谁设的？**是 Service 强制设的**（account.setUserId(当前登录用户)），
              不是前端传的。这一点非常重要，见 AccountService.create()。
        -->
        INSERT INTO account (user_id, name, balance)
        VALUES (#{userId}, #{name}, #{balance})
    </insert>

    <!--
        ============================================================
          【重点】useGeneratedKeys="true" keyProperty="id" 是干什么的？
        ============================================================

        问题来了：我们 INSERT 时没有传 id，是数据库自己生成的自增值。
        那"新插入的这条记录 id 到底是多少"，程序怎么知道？

        答案就是这两个属性，它们让 MyBatis 做一件事：
          INSERT 执行完，立刻把数据库生成的自增主键，**回填到你传进去的那个对象上**。

        效果（等下我们用接口实测给你看）：
          调用 insert 之前：account.getId() 是 null
          调用 insert 之后：account.getId() 就是数据库新分配的 id（比如 3）

        因为 Java 对象是"引用传递"，MyBatis 改的是你手上那个对象本身，
        所以调用方（Service）不用接收返回值也能拿到新 id。

        什么时候需要它？
          · 插入"账单"后要跳转到详情页，需要 id → 必须回填
          · 插入主表后要接着插子表（子表要存主表 id）→ 必须回填
        现在虽然用不上，但这是写操作必学的知识点，先埋在这里。
    -->

    <!--
        ============================================================
          按 id 查单条 —— 为"改"和"删"做前置检查
        ============================================================
        这是本项目第一个"带参数"的查询。
        注意 #{id} —— 它会用 PreparedStatement 的方式填进去，
        底层生成的 SQL 是：SELECT ... WHERE id = ?  然后绑定值。
        所以哪怕传进来的是奇怪字符，也只会被当成"值"，不会被当成 SQL 执行。
    -->
    <select id="findById" resultType="Account">
        SELECT id, name, balance, created_at
        FROM account
        <!--
            【Day11 改动】多了一个 AND user_id = #{userId}
              别小看这个 AND，它是"水平越权"的唯一防线：

                别人就算猜到了你的账户 id（比如 1），
                加上这个条件后 SQL 也只会返回空 → MyBatis 返回 null
                → 后面"修改别人的账户""删别人的账户"自然全部失败。

              **把安全做成查询的副作用，而不是写一堆 if 去判断。**
              这是比"每处手写校验"可靠得多的做法 ——
              因为 if 会漏写，而 WHERE 条件写在 SQL 里就没法绕。
        -->
        WHERE id = #{id}
          AND user_id = #{userId}
    </select>

    <!--
        ============================================================
          修改账户
        ============================================================
        一条 UPDATE 语句由两部分组成，职责完全不同：

            UPDATE account            ← 改哪张表
            SET name = ?, balance = ? ← 改成什么（新值）
            WHERE id = ?              ← 改哪几条（定位）

        ============================================================
          【必须牢记的经典事故】忘记写 WHERE 会怎样？
        ============================================================
        如果不写 WHERE 子句，这条语句就变成"把整张表每一行都改掉"。

        看个对比：
            UPDATE account SET balance = 0 WHERE id = 6   → 只改中国银行这一条 ✓
            UPDATE account SET balance = 0                → 所有账户余额全变 0 💀

        这在真实生产环境里发生过无数次，是最著名的"事故级"错误之一。
        所以行业里有个硬规矩：
            **写 UPDATE / DELETE 之前，先用 SELECT 同样的 WHERE 条件试一次**，
            看看要影响的是不是你以为的那几行。

        ============================================================
          为什么这里是"全字段更新"，没有做"只改用户改动的字段"？
        ============================================================
        现在这种写法（把 name 和 balance 都重新赋值）叫"全字段更新"。
        对这个场景它是合适的，因为表单里本来就把两个字段都展示出来给用户改了。

        但如果字段很多（比如 20 个），全字段更新会带来两个问题：
          1) 用户只想改余额，却把其他 19 个字段也"重写"了一遍 —— 如果前端少传了某个字段，
             那个字段就会被写成 null，数据就丢了
          2) 并发场景下会互相覆盖

        那时就要用 MyBatis 的**动态 SQL**（<set> 配合 <if> 标签），
        实现"哪个字段有值才更新哪个"。
        这个我们等做账单表字段变多时再学 —— 现在知道有这么个东西就行。
    -->
    <update id="update">
        UPDATE account
        SET name = #{name},
            balance = #{balance}
        <!--
            WHERE 本来就是命根子（忘了就是改全表）；
            Day11 又加了一个 AND user_id —— 变成"只能改自己的"。
            两重保护：前者防"手滑改全表"，后者防"故意改别人"。
        -->
        WHERE id = #{id}
          AND user_id = #{userId}
    </update>

    <!--
        ============================================================
          删除账户
        ============================================================
        同样，WHERE 是命根子，忘了就是"清空整张表"。

        删完的后果（今天我们会亲手验证一次）：
          · 数据行没了
          · 但自增 ID 的计数器**不会回退** —— 删掉 id=18，下次新增还是 19
          所以你会看到 id 号出现"空洞"，这是正常现象（Day3 讲过原理，今天动手看）
    -->
    <delete id="deleteById">
        DELETE FROM account
        <!-- Day11：只能删自己的 —— 删别人的会"影响 0 行" -->
        WHERE id = #{id}
          AND user_id = #{userId}
    </delete>

    <!--
        ============================================================
          【Day7 新增】增量更新余额
        ============================================================

        仔细看这一行：

            SET balance = balance + #{delta}
                ↑左边       ↑右边也用了同一个列名

        这在 SQL 里是合法的，而且正是我们想要的效果：
          含义是"取出这一行当前的 balance，加上 delta，再存回去"。
          注意它**不是**在 Java 里算好的，是让数据库自己算的。

        举例：微信钱包当前 1000，调用 updateBalance(1, -35)
          → 数据库执行：balance = 1000 + (-35) = 965
          → 结果 965

        为什么必须这样写（而不是 Java 里算好再传最终值）？
          原因在 AccountMapper.java 的注释里详细讲了 —— 关键词是"丢失更新"。
          一句话：数据库有锁能保证顺序，Java 代码之间没有。

        【顺便注意】WHERE id = #{id} 依然是命根子，忘了就是改全表。
    -->
    <update id="updateBalance">
        UPDATE account
        SET balance = balance + #{delta}
        <!-- Day11：加上 user_id 条件，属于"纵深防御" -->
        WHERE id = #{id}
          AND user_id = #{userId}
    </update>

</mapper>
