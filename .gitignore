# Maven 编译产物目录，自动生成，不要提交
target/

# IDEA 的项目配置（每个人不一样，不该共享）
.idea/
*.iml

# VS Code
.vscode/

# 日志文件
*.log
logs/

# 前端依赖（体积巨大，绝对不能提交；换台电脑用 npm install 重新装）
node_modules/

# 前端打包产物
dist/

# 系统文件
.DS_Store
Thumbs.db

# ---------------------------------------------------------------
# 部署时的敏感配置（数据库密码、JWT 密钥）—— 绝不能进版本库
#
# 【为什么开头必须有斜杠】这是个真实的坑：
#     写  config/     → Git 会匹配【任意层级】叫 config 的目录
#                      结果把 backend/src/main/java/.../moneylog/config/
#                      这个【代码包】也一起忽略了（里面有 WebConfig.java！）
#     写  /config/    → 只匹配仓库【根目录】下的 config
#
# 【一句话】.gitignore 里的路径，能带前导斜杠就带，让匹配范围可控。
# ---------------------------------------------------------------
/config/

